{
  "version": 2,
  "functions": {
    "api/index.js": { "includeFiles": "backend/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/((?!api/|frontend/).*)", "destination": "/frontend/$1" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
